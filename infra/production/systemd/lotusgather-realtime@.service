[Unit]
Description=Lotus Gather realtime node %i
After=network-online.target redis-server.service lotusgather-api.service
Wants=network-online.target

[Service]
Type=simple
User=lotusgather
Group=lotusgather
WorkingDirectory=/opt/lotusgather/current
EnvironmentFile=/etc/lotusgather/common.env
EnvironmentFile=/etc/lotusgather/realtime-%i.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/realtime/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=45
LimitNOFILE=200000
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
