# /etc/lotus/lotus.env — cấu hình chung cho lotus-api, lotus-realtime, lotus-web.
# Chép file này thành /etc/lotus/lotus.env rồi điền giá trị thật:
#   sudo install -d -m 750 /etc/lotus && sudo cp lotus.env.example /etc/lotus/lotus.env && sudo chmod 600 /etc/lotus/lotus.env
# Mỗi dòng KEY=VALUE, không dùng `export`, không để dấu cách hai bên dấu =.

# BẮT BUỘC: cùng một khóa cho API và realtime (tạo bằng: openssl rand -base64 48).
SESSION_SECRET=
# Khóa trang admin (khác SESSION_SECRET).
ADMIN_SECRET=

# Dữ liệu (tài khoản, vườn, sớ, phiếu hỗ trợ). Thư mục phải thuộc user chạy dịch vụ.
DATA_DIR=/var/lib/lotus

# Cổng nội bộ (chỉ nghe 127.0.0.1; Caddy/Nginx đứng trước, mở 80/443 ra ngoài và chuyển vào WEB_PORT).
WEB_PORT=3000
API_PORT=4000
REALTIME_PORT=4001
API_UPSTREAM=http://127.0.0.1:4000
REALTIME_UPSTREAM=http://127.0.0.1:4001
REALTIME_PUBLIC_URL=/ws
REALTIME_INTERNAL_URL=http://127.0.0.1:4001
API_INTERNAL_URL=http://127.0.0.1:4000
NODE_ID=rt-vps-1

# Tùy chọn
# GOOGLE_CLIENT_ID=
# BOTS_THIEN=16
# BOTS_GAME=8
# BOTS_TAIXIU=8
# GARDEN_TIMEZONE=America/Los_Angeles
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# SUPPORT_ADMIN_URL=https://ten-mien-cua-ban/admin-thien.html
# DONATE_ZELLE_NAME=
# DONATE_ZELLE_HANDLE=
# DONATE_MONTHLY_GOAL=
# DONATE_MONTH_RAISED=
