# Sao chép thành /etc/lotusgather/common.env, chmod 600. Không commit giá trị thật.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=replace-with-a-different-random-secret
REDIS_URL=redis://127.0.0.1:6379
DATA_DIR=/var/lib/lotusgather
ALLOWED_ORIGIN_HOSTS=lotusgather.online,www.lotusgather.online
API_INTERNAL_URL=http://127.0.0.1:4000
REALTIME_INTERNAL_URL=http://127.0.0.1:4001
GOOGLE_CLIENT_ID=
GARDEN_TIMEZONE=America/Phoenix
SUPPORT_ADMIN_URL=https://lotusgather.online/admin-thien.html
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
DONATE_ZELLE_NAME=
DONATE_ZELLE_HANDLE=
DONATE_MEMO=Ung ho Lotus Gather
DONATE_MONTHLY_GOAL=
DONATE_MONTH_RAISED=
DONATE_CONTACT=
# Shop nhân vật: nạp kim cương qua Stripe Checkout (để trống thì tắt nạp). Webhook: https://lotusgather.online/api/v1/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_URL=https://lotusgather.online
